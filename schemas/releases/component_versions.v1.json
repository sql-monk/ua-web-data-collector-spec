{
  "$id": "https://ua-collector.local/schemas/releases/component_versions.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Версії коду/моделей, що впливають на відтворюваність (§9.9).",
  "properties": {
    "glossary_version": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Glossary Version"
    },
    "matcher_version": {
      "minLength": 1,
      "title": "Matcher Version",
      "type": "string"
    },
    "normalizer_version": {
      "minLength": 1,
      "title": "Normalizer Version",
      "type": "string"
    },
    "parser_version": {
      "minLength": 1,
      "title": "Parser Version",
      "type": "string"
    },
    "resolution_version": {
      "minLength": 1,
      "title": "Resolution Version",
      "type": "string"
    },
    "schema_version": {
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "title": "Schema Version",
      "type": "string"
    },
    "translation_model_version": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Translation Model Version"
    },
    "translation_provider": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Translation Provider"
    }
  },
  "required": [
    "matcher_version",
    "normalizer_version",
    "parser_version",
    "resolution_version",
    "schema_version"
  ],
  "title": "ComponentVersions",
  "type": "object",
  "x-contract-version": "1.0"
}
