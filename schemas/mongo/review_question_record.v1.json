{
  "$defs": {
    "Lineage": {
      "additionalProperties": false,
      "description": "Блок `lineage` (§9.2): fetch → raw → parser → projection task.",
      "properties": {
        "fetch_id": {
          "format": "uuid",
          "title": "Fetch Id",
          "type": "string"
        },
        "parser_version": {
          "minLength": 1,
          "title": "Parser Version",
          "type": "string"
        },
        "projection_task_id": {
          "format": "uuid",
          "title": "Projection Task Id",
          "type": "string"
        },
        "raw_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Raw Sha256",
          "type": "string"
        }
      },
      "required": [
        "fetch_id",
        "parser_version",
        "projection_task_id",
        "raw_sha256"
      ],
      "title": "Lineage",
      "type": "object"
    },
    "ReviewQuestionKind": {
      "description": "Тип user-generated запису каталогу (§5.2, §9.2 `product_reviews`/`product_questions`).",
      "enum": [
        "review",
        "question"
      ],
      "title": "ReviewQuestionKind",
      "type": "string"
    },
    "SourceIdentity": {
      "additionalProperties": false,
      "description": "Первинний природний ключ `(source_id, source_item_id)` (§9.3 п.1).",
      "properties": {
        "source_id": {
          "description": "ID джерела з docs/research/source-registry.yaml.",
          "maxLength": 64,
          "pattern": "^(news|vehicle|catalog)_[a-z]{2}_[a-z0-9]+(_[a-z0-9]+)*$",
          "title": "Source Id",
          "type": "string"
        },
        "source_item_id": {
          "description": "Стабільний ID сутності на джерелі.",
          "maxLength": 512,
          "minLength": 1,
          "title": "Source Item Id",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "source_item_id"
      ],
      "title": "SourceIdentity",
      "type": "object"
    }
  },
  "$id": "https://ua-collector.local/schemas/mongo/review_question_record.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`product_reviews`/`product_questions` (§5.2, §9.2): мінімальні обов'язкові поля.\n\n`content_version` — source update version/timestamp або deterministic content hash; unique\n`(source.source_id, source.source_item_id, content_version)`. Автор/rating/text/status\nдодає WP-09 optional-полями minor-версії.",
  "properties": {
    "_id": {
      "description": "ID запису (UUID).",
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "content_version": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Content Version",
      "type": "string"
    },
    "lineage": {
      "$ref": "#/$defs/Lineage"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "parent_item_id": {
      "description": "Parent catalog item UUID (назва — index §9.2).",
      "format": "uuid",
      "title": "Parent Item Id",
      "type": "string"
    },
    "projection_task_id": {
      "format": "uuid",
      "title": "Projection Task Id",
      "type": "string"
    },
    "published_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Source time; nullable.",
      "title": "Published At"
    },
    "record_kind": {
      "$ref": "#/$defs/ReviewQuestionKind"
    },
    "schema_version": {
      "default": "1.0",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/SourceIdentity"
    },
    "updated_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Source time; nullable.",
      "title": "Updated At"
    }
  },
  "required": [
    "_id",
    "content_version",
    "lineage",
    "observed_at",
    "parent_item_id",
    "projection_task_id",
    "record_kind",
    "source"
  ],
  "title": "ReviewQuestionRecord",
  "type": "object",
  "x-contract-version": "1.0"
}
