{
  "$defs": {
    "DataDomain": {
      "description": "Домен даних; збігається з `kind` у `docs/research/source-registry.yaml`.",
      "enum": [
        "news",
        "vehicle",
        "catalog"
      ],
      "title": "DataDomain",
      "type": "string"
    },
    "EntityKind": {
      "description": "`entity_kind` current document (§9.2); розширюється WP-07/WP-09 через dependency-запит.",
      "enum": [
        "catalog_item",
        "catalog_offer",
        "vehicle_listing",
        "seller"
      ],
      "title": "EntityKind",
      "type": "string"
    },
    "EntityTime": {
      "additionalProperties": false,
      "description": "Блок `time` current document (§9.2): source і system осі в одному об'єкті.\n\nРегресія R-43: `source_event_at`/`source_updated_at`, що точно дорівнюють `fetched_at`,\nвідхиляються — це ознака підміни source time crawler time (§9.6).",
      "properties": {
        "fetched_at": {
          "format": "date-time",
          "title": "Fetched At",
          "type": "string"
        },
        "ingested_at": {
          "format": "date-time",
          "title": "Ingested At",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "source_event_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Event At"
        },
        "source_time_inferred": {
          "default": false,
          "title": "Source Time Inferred",
          "type": "boolean"
        },
        "source_time_precision": {
          "$ref": "#/$defs/TimePrecision",
          "default": "unknown"
        },
        "source_timezone_raw": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Timezone Raw"
        },
        "source_updated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Updated At"
        }
      },
      "required": [
        "fetched_at",
        "ingested_at",
        "observed_at"
      ],
      "title": "EntityTime",
      "type": "object"
    },
    "JsonValue": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "Lineage": {
      "additionalProperties": false,
      "description": "Блок `lineage` (§9.2): fetch → raw → parser → projection task.",
      "properties": {
        "fetch_id": {
          "format": "uuid",
          "title": "Fetch Id",
          "type": "string"
        },
        "parser_version": {
          "minLength": 1,
          "title": "Parser Version",
          "type": "string"
        },
        "projection_task_id": {
          "format": "uuid",
          "title": "Projection Task Id",
          "type": "string"
        },
        "raw_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Raw Sha256",
          "type": "string"
        }
      },
      "required": [
        "fetch_id",
        "parser_version",
        "projection_task_id",
        "raw_sha256"
      ],
      "title": "Lineage",
      "type": "object"
    },
    "NormalizedArtifactRef": {
      "additionalProperties": false,
      "description": "Normalized projection artifact (§9.1 `normalized_artifacts`) з lineage до raw/fetch.",
      "properties": {
        "domain": {
          "$ref": "#/$defs/DataDomain"
        },
        "entity_uuid": {
          "format": "uuid",
          "title": "Entity Uuid",
          "type": "string"
        },
        "fetch_id": {
          "format": "uuid",
          "title": "Fetch Id",
          "type": "string"
        },
        "media_type": {
          "minLength": 3,
          "pattern": "^[\\w.+-]+/[\\w.+-]+(;.*)?$",
          "title": "Media Type",
          "type": "string"
        },
        "parser_version": {
          "minLength": 1,
          "title": "Parser Version",
          "type": "string"
        },
        "produced_at": {
          "format": "date-time",
          "title": "Produced At",
          "type": "string"
        },
        "raw_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Raw Sha256",
          "type": "string"
        },
        "raw_uri": {
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9+.-]*://.+",
          "title": "Raw Uri",
          "type": "string"
        },
        "schema_version": {
          "description": "Версія схеми normalized payload.",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "uri": {
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9+.-]*://.+",
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "domain",
        "entity_uuid",
        "fetch_id",
        "media_type",
        "parser_version",
        "produced_at",
        "raw_sha256",
        "raw_uri",
        "schema_version",
        "sha256",
        "size_bytes",
        "uri"
      ],
      "title": "NormalizedArtifactRef",
      "type": "object"
    },
    "SourceRef": {
      "additionalProperties": false,
      "description": "Блок `source` current document: identity + canonical URL (§9.2).",
      "properties": {
        "canonical_url": {
          "minLength": 1,
          "title": "Canonical Url",
          "type": "string"
        },
        "source_id": {
          "description": "ID джерела з docs/research/source-registry.yaml.",
          "maxLength": 64,
          "pattern": "^(news|vehicle|catalog)_[a-z]{2}_[a-z0-9]+(_[a-z0-9]+)*$",
          "title": "Source Id",
          "type": "string"
        },
        "source_item_id": {
          "description": "Стабільний ID сутності на джерелі.",
          "maxLength": 512,
          "minLength": 1,
          "title": "Source Item Id",
          "type": "string"
        }
      },
      "required": [
        "canonical_url",
        "source_id",
        "source_item_id"
      ],
      "title": "SourceRef",
      "type": "object"
    },
    "TimePrecision": {
      "description": "Точність часу, заявленого джерелом (§9.6).",
      "enum": [
        "second",
        "minute",
        "hour",
        "day",
        "month",
        "year",
        "unknown"
      ],
      "title": "TimePrecision",
      "type": "string"
    },
    "VersionSnapshot": {
      "additionalProperties": false,
      "description": "Bounded snapshot однієї версії (§9.2): те, що стало б current document цієї версії.",
      "properties": {
        "attributes": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Attributes",
          "type": "object"
        },
        "core": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Core",
          "type": "object"
        },
        "identity_hash": {
          "pattern": "^v[1-9][0-9]*:[0-9a-f]{64}$",
          "title": "Identity Hash",
          "type": "string"
        },
        "latest_state": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Latest State",
          "type": "object"
        },
        "source": {
          "$ref": "#/$defs/SourceRef"
        },
        "time": {
          "$ref": "#/$defs/EntityTime"
        }
      },
      "required": [
        "core",
        "identity_hash",
        "source",
        "time"
      ],
      "title": "VersionSnapshot",
      "type": "object"
    }
  },
  "$id": "https://ua-collector.local/schemas/mongo/entity_projection_version.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`entity_projection_versions` (§9.2, R-36): версія для кожної task, незалежно від CAS.\n\n`previous_version`/`previous_state_hash` — current document у момент task (`None` — current\nще не існував). Інваріанти CAS: `applied_to_current` ⇔ current відсутній або старіший;\n`state_changed` ⇔ `state_hash` ≠ `previous_state_hash`. Потрібне хоча б одне з `snapshot`\n(bounded, §9.2) або `artifact` (immutable normalized artifact ref).",
  "properties": {
    "_id": {
      "description": "ID запису (UUID, генерує projector).",
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "applied_to_current": {
      "title": "Applied To Current",
      "type": "boolean"
    },
    "artifact": {
      "anyOf": [
        {
          "$ref": "#/$defs/NormalizedArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "entity_kind": {
      "$ref": "#/$defs/EntityKind"
    },
    "entity_uuid": {
      "format": "uuid",
      "title": "Entity Uuid",
      "type": "string"
    },
    "lineage": {
      "$ref": "#/$defs/Lineage"
    },
    "previous_state_hash": {
      "anyOf": [
        {
          "pattern": "^v[1-9][0-9]*:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Previous State Hash"
    },
    "previous_version": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Previous Version"
    },
    "projection_task_id": {
      "format": "uuid",
      "title": "Projection Task Id",
      "type": "string"
    },
    "projection_version": {
      "description": "Монотонна per-entity_uuid (int64).",
      "minimum": 1,
      "title": "Projection Version",
      "type": "integer"
    },
    "recorded_at": {
      "description": "Час запису version record (Mongo commit).",
      "format": "date-time",
      "title": "Recorded At",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "title": "Schema Version",
      "type": "string"
    },
    "snapshot": {
      "anyOf": [
        {
          "$ref": "#/$defs/VersionSnapshot"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "state_changed": {
      "title": "State Changed",
      "type": "boolean"
    },
    "state_hash": {
      "pattern": "^v[1-9][0-9]*:[0-9a-f]{64}$",
      "title": "State Hash",
      "type": "string"
    },
    "target_collection": {
      "description": "Current collection сутності.",
      "maxLength": 120,
      "pattern": "^[a-z][a-z0-9_]*$",
      "title": "Target Collection",
      "type": "string"
    }
  },
  "required": [
    "_id",
    "applied_to_current",
    "entity_kind",
    "entity_uuid",
    "lineage",
    "projection_task_id",
    "projection_version",
    "recorded_at",
    "state_changed",
    "state_hash",
    "target_collection"
  ],
  "title": "EntityProjectionVersion",
  "type": "object",
  "x-contract-version": "1.0"
}
