{
  "$id": "https://ua-collector.local/schemas/common/version_times.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Вхід `build_intervals`: одна версія сутності з `effective_at` та `ingested_at`.",
  "properties": {
    "effective_at": {
      "format": "date-time",
      "title": "Effective At",
      "type": "string"
    },
    "ingested_at": {
      "format": "date-time",
      "title": "Ingested At",
      "type": "string"
    },
    "projection_version": {
      "minimum": 1,
      "title": "Projection Version",
      "type": "integer"
    }
  },
  "required": [
    "effective_at",
    "ingested_at",
    "projection_version"
  ],
  "title": "VersionTimes",
  "type": "object",
  "x-contract-version": "1.0"
}
