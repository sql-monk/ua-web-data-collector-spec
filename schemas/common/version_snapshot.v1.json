{
  "$defs": {
    "EntityTime": {
      "additionalProperties": false,
      "description": "Блок `time` current document (§9.2): source і system осі в одному об'єкті.\n\nРегресія R-43: `source_event_at`/`source_updated_at`, що точно дорівнюють `fetched_at`,\nвідхиляються — це ознака підміни source time crawler time (§9.6).",
      "properties": {
        "fetched_at": {
          "format": "date-time",
          "title": "Fetched At",
          "type": "string"
        },
        "ingested_at": {
          "format": "date-time",
          "title": "Ingested At",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "source_event_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Event At"
        },
        "source_time_inferred": {
          "default": false,
          "title": "Source Time Inferred",
          "type": "boolean"
        },
        "source_time_precision": {
          "$ref": "#/$defs/TimePrecision",
          "default": "unknown"
        },
        "source_timezone_raw": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Timezone Raw"
        },
        "source_updated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Updated At"
        }
      },
      "required": [
        "fetched_at",
        "ingested_at",
        "observed_at"
      ],
      "title": "EntityTime",
      "type": "object"
    },
    "JsonValue": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "SourceRef": {
      "additionalProperties": false,
      "description": "Блок `source` current document: identity + canonical URL (§9.2).",
      "properties": {
        "canonical_url": {
          "minLength": 1,
          "title": "Canonical Url",
          "type": "string"
        },
        "source_id": {
          "description": "ID джерела з docs/research/source-registry.yaml.",
          "maxLength": 64,
          "pattern": "^(news|vehicle|catalog)_[a-z]{2}_[a-z0-9]+(_[a-z0-9]+)*$",
          "title": "Source Id",
          "type": "string"
        },
        "source_item_id": {
          "description": "Стабільний ID сутності на джерелі.",
          "maxLength": 512,
          "minLength": 1,
          "title": "Source Item Id",
          "type": "string"
        }
      },
      "required": [
        "canonical_url",
        "source_id",
        "source_item_id"
      ],
      "title": "SourceRef",
      "type": "object"
    },
    "TimePrecision": {
      "description": "Точність часу, заявленого джерелом (§9.6).",
      "enum": [
        "second",
        "minute",
        "hour",
        "day",
        "month",
        "year",
        "unknown"
      ],
      "title": "TimePrecision",
      "type": "string"
    }
  },
  "$id": "https://ua-collector.local/schemas/common/version_snapshot.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Bounded snapshot однієї версії (§9.2): те, що стало б current document цієї версії.",
  "properties": {
    "attributes": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Attributes",
      "type": "object"
    },
    "core": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Core",
      "type": "object"
    },
    "identity_hash": {
      "pattern": "^v[1-9][0-9]*:[0-9a-f]{64}$",
      "title": "Identity Hash",
      "type": "string"
    },
    "latest_state": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Latest State",
      "type": "object"
    },
    "source": {
      "$ref": "#/$defs/SourceRef"
    },
    "time": {
      "$ref": "#/$defs/EntityTime"
    }
  },
  "required": [
    "core",
    "identity_hash",
    "source",
    "time"
  ],
  "title": "VersionSnapshot",
  "type": "object",
  "x-contract-version": "1.0"
}
