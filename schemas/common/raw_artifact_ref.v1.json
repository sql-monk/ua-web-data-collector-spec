{
  "$id": "https://ua-collector.local/schemas/common/raw_artifact_ref.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Raw artifact (§9.1 `raw_objects`) з HTTP metadata fetch.",
  "properties": {
    "content_encoding": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Content Encoding"
    },
    "content_type": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Content Type"
    },
    "etag": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Etag"
    },
    "fetch_id": {
      "format": "uuid",
      "title": "Fetch Id",
      "type": "string"
    },
    "fetched_at": {
      "format": "date-time",
      "title": "Fetched At",
      "type": "string"
    },
    "final_url": {
      "minLength": 1,
      "title": "Final Url",
      "type": "string"
    },
    "http_status": {
      "maximum": 599,
      "minimum": 100,
      "title": "Http Status",
      "type": "integer"
    },
    "last_modified": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Заголовок Last-Modified як отримано (raw), без парсингу.",
      "title": "Last Modified"
    },
    "media_type": {
      "minLength": 3,
      "pattern": "^[\\w.+-]+/[\\w.+-]+(;.*)?$",
      "title": "Media Type",
      "type": "string"
    },
    "requested_url": {
      "minLength": 1,
      "title": "Requested Url",
      "type": "string"
    },
    "schema_version": {
      "anyOf": [
        {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Версія схеми вмісту artifact (для normalized/event payload).",
      "title": "Schema Version"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sha256",
      "type": "string"
    },
    "size_bytes": {
      "minimum": 0,
      "title": "Size Bytes",
      "type": "integer"
    },
    "uri": {
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9+.-]*://.+",
      "title": "Uri",
      "type": "string"
    }
  },
  "required": [
    "fetch_id",
    "fetched_at",
    "final_url",
    "http_status",
    "media_type",
    "requested_url",
    "sha256",
    "size_bytes",
    "uri"
  ],
  "title": "RawArtifactRef",
  "type": "object",
  "x-contract-version": "1.0"
}
