{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ArtifactReadiness",
      "Effect": "Allow",
      "Action": ["s3:GetBucketLocation"],
      "Resource": [
        "arn:aws:s3:::normalized",
        "arn:aws:s3:::events",
        "arn:aws:s3:::archive"
      ]
    },
    {
      "Sid": "NormalizedRead",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": ["arn:aws:s3:::normalized/*"]
    },
    {
      "Sid": "EventsWrite",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject"],
      "Resource": ["arn:aws:s3:::events/*"]
    },
    {
      "Sid": "ArchiveWriteAndSweep",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:DeleteObject"],
      "Resource": ["arn:aws:s3:::archive/*"]
    }
  ]
}
