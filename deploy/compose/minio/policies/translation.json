{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ArtifactReadiness",
      "Effect": "Allow",
      "Action": ["s3:GetBucketLocation"],
      "Resource": ["arn:aws:s3:::normalized", "arn:aws:s3:::translated"]
    },
    {
      "Sid": "NormalizedRead",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": ["arn:aws:s3:::normalized/*"]
    },
    {
      "Sid": "TranslatedWrite",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject"],
      "Resource": ["arn:aws:s3:::translated/*"]
    }
  ]
}
