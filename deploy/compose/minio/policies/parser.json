{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RawRead",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": ["arn:aws:s3:::raw/*"]
    },
    {
      "Sid": "NormalizedWrite",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject"],
      "Resource": ["arn:aws:s3:::normalized/*"]
    }
  ]
}
