{
  // Код застосунку (§8: TypeScript strict). Unit-тести — окремий проєкт
  // `tsconfig.test.json`: їм потрібні типи `node`, а `src` має лишатись браузерним.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": { "~/*": ["./src/*"] },
    "jsx": "react-jsx",
    "types": ["vitest/globals", "@testing-library/jest-dom"],

    // strict + додаткові перевірки, яких `strict` не вмикає.
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "useDefineForClassFields": true,

    // Емісія — Vite; tsc лише перевіряє типи (`tsc -b` потребує tsBuildInfoFile).
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo"
  },
  "include": ["src"]
}
